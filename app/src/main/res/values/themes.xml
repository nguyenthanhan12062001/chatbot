<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ChatAI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sunset_primary</item>
        <item name="colorSecondary">@color/sunset_secondary</item>
        <item name="android:windowBackground">@color/sunset_bg_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="ThemeOverlay.ChatAI.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.ChatAI.BottomSheet</item>
    </style>

    <style name="Widget.ChatAI.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ChatAI.TopRounded</item>
    </style>

    <style name="ShapeAppearance.ChatAI.TopRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
