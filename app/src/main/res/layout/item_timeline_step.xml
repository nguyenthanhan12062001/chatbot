<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/timeline_step_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:id="@+id/ll_timeline_step_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_timeline_step_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_psychology" />

        <TextView
            android:id="@+id/tv_timeline_step_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:textSize="11.5sp"
            android:textStyle="bold"
            tools:text="AI Thinking" />

        <TextView
            android:id="@+id/tv_timeline_step_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="11.5sp"
            tools:text="Analyzing project structure..." />

        <TextView
            android:id="@+id/tv_timeline_step_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/timeline_show_details"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_timeline_step_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textIsSelectable="true"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Step details appear here when expanded."
        tools:visibility="visible" />
</LinearLayout>
