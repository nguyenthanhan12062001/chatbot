<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/message_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingHorizontal="2dp"
    android:paddingVertical="5dp">

    <!-- Compact Assistant Header (hidden for User bubbles so short bubbles stay crisp) -->
    <LinearLayout
        android:id="@+id/layout_message_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginBottom="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/avatar_assistant_badge"
            android:layout_width="18dp"
            android:layout_height="18dp">

            <ImageView
                android:id="@+id/iv_assistant_avatar"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_chat_spark" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_message_role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="11.5sp"
            android:textStyle="bold"
            tools:text="AnAI" />

        <TextView
            android:id="@+id/tv_message_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxWidth="150dp"
            android:maxLines="1"
            android:singleLine="true"
            android:textSize="10.5sp"
            tools:text="GPT-4o Mini" />

        <TextView
            android:id="@+id/tv_message_access_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Compact Collapsible Thinking Pill / Drawer (outside answer bubble) -->
    <com.chatai.an.presentation.chat.MaxWidthLinearLayout
        android:id="@+id/thinking_process_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/btn_toggle_thinking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="24dp"
            android:orientation="horizontal"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp">

            <ImageView
                android:id="@+id/iv_thinking_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_psychology" />

            <TextView
                android:id="@+id/tv_thinking_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/thinking_process_title"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_thinking_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/thinking_process_toggle_show"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_thinking_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:paddingHorizontal="11dp"
            android:paddingTop="2dp"
            android:paddingBottom="9dp"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:visibility="gone" />
    </com.chatai.an.presentation.chat.MaxWidthLinearLayout>

    <!-- Inline Tool Execution Cards (legacy fallback when timelineEntries is empty) -->
    <com.chatai.an.presentation.chat.MaxWidthLinearLayout
        android:id="@+id/ll_tool_cards_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Chronological AI Activity Timeline (Thinking -> Tool Calls -> Commentary) -->
    <com.chatai.an.presentation.chat.MaxWidthLinearLayout
        android:id="@+id/ll_timeline_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Dynamic Content-Hugging Chat Bubble -->
    <com.chatai.an.presentation.chat.MaxWidthLinearLayout
        android:id="@+id/message_bubble_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp">

        <!-- Attachments inside message -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_message_attachments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone" />

        <!-- Dynamic Markdown, Table, LaTeX, Image & Code Block container -->
        <LinearLayout
            android:id="@+id/markdown_segments_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </com.chatai.an.presentation.chat.MaxWidthLinearLayout>

    <!-- Expandable Referenced Sources Accordion -->
    <com.chatai.an.presentation.chat.MaxWidthLinearLayout
        android:id="@+id/ll_sources_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Compact Metadata & Action Strip (outside bubble so it never inflates bubble size) -->
    <LinearLayout
        android:id="@+id/layout_message_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_message_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10.5sp"
            tools:text="12:20" />

        <TextView
            android:id="@+id/tv_message_edited"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="@string/edited_label"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_message_deep_thinking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_message_tokens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <View
            android:id="@+id/spacer_footer_actions"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_msg_copy"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_copy"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_copy" />

        <ImageButton
            android:id="@+id/btn_msg_more"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_more"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <!-- Continue in Code handover chip & Horizontal Suggested Follow-Up Chips -->
    <com.chatai.an.presentation.chat.MaxWidthLinearLayout
        android:id="@+id/ll_post_message_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/btn_msg_handover_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="30dp"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_handover_code"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_build" />

            <TextView
                android:id="@+id/tv_handover_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/action_continue_in_code"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/hsv_follow_up_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ll_follow_up_chips_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone" />
        </HorizontalScrollView>
    </com.chatai.an.presentation.chat.MaxWidthLinearLayout>
</LinearLayout>
