<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/terminal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top App Bar with Backend Toggle (App Terminal vs Termux) -->
    <LinearLayout
        android:id="@+id/terminal_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <ImageButton
            android:id="@+id/btn_terminal_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_terminal_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/terminal_title"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_terminal_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textSize="11sp"
                tools:text="~/workspaces/default" />
        </LinearLayout>

        <!-- Segmented Backend Switcher: App Terminal | Termux -->
        <LinearLayout
            android:id="@+id/layout_backend_switcher"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btn_backend_app"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/terminal_backend_app"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_backend_termux"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/terminal_backend_termux"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_terminal_copy"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/terminal_cd_copy"
            android:padding="12dp"
            android:src="@drawable/ic_copy" />

        <ImageButton
            android:id="@+id/btn_terminal_clear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/terminal_cd_clear"
            android:padding="12dp"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <!-- Backend Status Strip -->
    <LinearLayout
        android:id="@+id/terminal_status_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp">

        <TextView
            android:id="@+id/tv_terminal_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="12sp"
            tools:text="Built-in sh ready • /data/user/0/..." />

        <TextView
            android:id="@+id/btn_terminal_open_hub"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/terminal_open_hub"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Monospace Dark IDE Console Viewport -->
    <LinearLayout
        android:id="@+id/terminal_console_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="2dp">

        <ScrollView
            android:id="@+id/sv_terminal_output"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_terminal_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:textColor="#E6EDF3"
                android:textIsSelectable="true"
                android:textSize="12.5sp"
                android:typeface="monospace"
                tools:text="workspace $ ls -la" />
        </ScrollView>
    </LinearLayout>

    <!-- CodeOnTheGo-inspired Extra Keys Bar -->
    <HorizontalScrollView
        android:id="@+id/hsv_extra_keys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/container_extra_keys"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Command Prompt & Input Bar -->
    <LinearLayout
        android:id="@+id/terminal_input_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/terminal_input_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/tv_terminal_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="6dp"
                android:fontFamily="monospace"
                android:text="$"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_terminal_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="monospace"
                android:hint="@string/terminal_input_hint"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLines="3"
                android:minHeight="44dp"
                android:paddingVertical="6dp"
                android:textSize="13.5sp"
                android:typeface="monospace" />

            <ImageButton
                android:id="@+id/btn_terminal_stop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/terminal_cd_stop"
                android:padding="12dp"
                android:src="@drawable/ic_stop"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_terminal_run"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/terminal_cd_run"
                android:padding="12dp"
                android:src="@drawable/ic_send" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
